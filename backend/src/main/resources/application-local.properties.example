# =============================================================================
# EXAMPLE local secrets file (SAFE to commit)
# Author: Subash Chandra Sahoo | Software Engineer
# Project: Odisha Flood Relief & NGO Management System
#
# SETUP:
#   1) Copy this file to: application-local.properties
#   2) Replace every CHANGE_ME value with your real secrets
#   3) Restart backend
#   4) NEVER commit application-local.properties
# =============================================================================

# Database
spring.datasource.url=jdbc:mysql://localhost:3306/flood_relief_ngo?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=CHANGE_ME_DB_PASSWORD

# JWT — generate a long random secret (do not reuse sample text in production)
jwt.secret=CHANGE_ME_JWT_SECRET_USE_LONG_RANDOM_VALUE

# Gmail OTP
# Create App Password: https://myaccount.google.com/apppasswords
app.mail.enabled=true
app.mail.from=CHANGE_ME@gmail.com
spring.mail.username=CHANGE_ME@gmail.com
spring.mail.password=CHANGE_ME_16_CHAR_APP_PASSWORD

# CORS
cors.allowed-origins=http://localhost:3000

# OTP
app.otp.dev-mode=false
app.otp.expiry-minutes=10
